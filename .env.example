# Proveedor LLM ("agy" = CLI nativo de Antigravity [por defecto] | "anthropic" = Claude 3.5 Sonnet)
LLM_PROVIDER=agy

# CLI de Antigravity (modo headless: agy -p "<prompt>")
AGY_BIN=agy
AGY_MODEL=gemini-3.8-flash-low
AGY_TIMEOUT_MS=180000
# Si es true, añade --json-schema para forzar salida estructurada desde el CLI
AGY_USE_JSON_SCHEMA=false

# Solo necesario si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Proveedor de Voz TTS ("edge" | "local")
TTS_PROVIDER=edge
TTS_VOICE=es-MX-JorgeNeural
LOCAL_TTS_URL=http://localhost:8880/v1/audio/speech
